# 复制成 .env.local 后填写（.env.local 不会被提交到 GitHub）

# Gemini（文案与图片生成）：https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Supabase（可选：登录与云端保存）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 简单登录（必须先登录才能使用网站和 AI 接口）
APP_LOGIN_EMAIL=
# 生成哈希：node -e 'const c=require("crypto");const s=c.randomBytes(16).toString("hex");console.log("scrypt:"+s+":"+c.scryptSync("你的密码",s,32).toString("hex"))'
APP_LOGIN_HASH=
# 随机字符串：node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
APP_SESSION_SECRET=
